generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Suite {
  id   String    @id @default(cuid())
  name String    @unique
  runs TestRun[]
}

model TestRun {
  id         String    @id @default(cuid())
  suiteId    String
  suite      Suite     @relation(fields: [suiteId], references: [id])
  status     RunStatus
  durationMs Int
  logs       String?   @db.Text
  startedAt  DateTime  @default(now())

  @@index([suiteId, startedAt])
  @@index([status])
}

enum RunStatus {
  PASSED
  FAILED
  FLAKY
}
