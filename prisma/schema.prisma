generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Suite {
  id               String           @id @default(cuid())
  name             String           @unique
  automationStatus AutomationStatus @default(AUTOMATED)
  testCases        Int              @default(0)
  runs             TestRun[]
  defects          Defect[]
}

model TestRun {
  id         String    @id @default(cuid())
  suiteId    String
  suite      Suite     @relation(fields: [suiteId], references: [id])
  status     RunStatus
  durationMs Int
  logs       String?   @db.Text
  startedAt  DateTime  @default(now())

  @@index([suiteId, startedAt])
  @@index([status])
}

model Defect {
  id        String         @id @default(cuid())
  key       String         @unique
  title     String
  severity  DefectSeverity
  status    DefectStatus   @default(OPEN)
  suiteId   String?
  suite     Suite?         @relation(fields: [suiteId], references: [id])
  createdAt DateTime       @default(now())
  closedAt  DateTime?

  @@index([status])
}

enum RunStatus {
  PASSED
  FAILED
  FLAKY
}

enum DefectStatus {
  OPEN
  CLOSED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AutomationStatus {
  AUTOMATED
  IN_PROGRESS
  MANUAL
}